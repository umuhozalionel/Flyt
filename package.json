{
  "name": "flyt",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "postinstall": "node scripts/copy-map-worker.mjs",
    "predev": "node scripts/copy-map-worker.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-map-worker.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test:db": "vitest run --config vitest.db.config.ts && supabase test db",
    "cloud:check": "node scripts/cloud-guard.mjs",
    "cloud:config-push": "node scripts/cloud-guard.mjs && supabase config push"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.119.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^6.19.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5",
    "shadcn": "^4.11.0",
    "supabase": "^3.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3",
    "vitest": "^3.2.7"
  }
}
