# Copy to supabase/functions/.env (never commit the real file). Local Supabase loads it for functions.
# Make a VAPID pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@flyt.rw
# Must match app.push_settings.secret in the database (the local seed uses this value).
PUSH_WEBHOOK_SECRET=local-dev-push-secret
