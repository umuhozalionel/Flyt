# Data source: "mock" (default, runs in the browser with sample data) or "supabase".
NEXT_PUBLIC_DATA_SOURCE=mock

# Supabase (Phase 6). Local CLI values are printed by `supabase start`.
# Only the public anon key goes here. Never put the service-role key in client code.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dev-only email and password sign-in for seeded demo users. Off by default. Never enable in production.
NEXT_PUBLIC_DEV_SIGNIN=false
